# AIPG Validator Node — systemd unit.
# Preferred install:
#   ./scripts/install-systemd.sh --dry-run
#   sudo ./scripts/install-systemd.sh
#
# Manual install:
#   sudo cp aipg-validator.service /etc/systemd/system/
#   # edit User=, WorkingDirectory=, ExecStart=, and VALIDATOR_ENV below
#   sudo systemctl daemon-reload && sudo systemctl enable --now aipg-validator
# Logs:  journalctl -u aipg-validator -f
[Unit]
Description=AIPG Validator Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGEME
WorkingDirectory=/home/CHANGEME/validator-node
ExecStart=/home/CHANGEME/validator-node/.venv/bin/aipg-validator run
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=VALIDATOR_ENV=/home/CHANGEME/validator-node/.env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
