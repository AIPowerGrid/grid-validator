# AIPG Validator Node - copy to .env and `chmod 600 .env`. Never commit .env.
# V0 preview: run as an observer/scorer with VALIDATOR_REQUIRE_STAKE=false.

# ── Grid ──
GRID_API_URL=https://api.aipowergrid.io
# V2 Grid API key. Validator role enforcement is a later core-side gate.
VALIDATOR_API_KEY=

# ── Identity / on-chain (Base) ──
# Optional in unsigned V0 preview. Leave blank unless you want a visible
# validator identity. If set, it must be a valid 20-byte 0x address.
VALIDATOR_WALLET=
# Private key signs attestations and later controls stake. SECRET. Optional in V0.
# If set, it must derive VALIDATOR_WALLET. `aipg-validator init` can derive
# the wallet for you when you leave the wallet prompt blank.
VALIDATOR_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
# Must be a valid 20-byte 0x address when set.
AIPG_TOKEN_ADDR=0xa1c0deCaFE3E9Bf06A5F29B7015CD373a9854608
# Set once ValidatorStaking is deployed. Must be a valid 20-byte 0x address
# when set.
VALIDATOR_STAKING_ADDR=
VALIDATOR_MIN_STAKE=50000
# V0 preview / local dev: skip the on-chain stake gate.
VALIDATOR_REQUIRE_STAKE=false

# ── Probing ──
PROBE_INTERVAL_S=60
PROBE_TIMEOUT_S=45
PROBE_MAX_TOKENS=256
LATENCY_BUDGET_S=30
# Future media/video scorer knobs. They are not used by the V0 model-routed
# text loop until media lanes are enabled.
MEDIA_LATENCY_BUDGET_S=60
VIDEO_LATENCY_BUDGET_S=120
PHASH_TOLERANCE=12

# ── Local dashboard ──
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8790
