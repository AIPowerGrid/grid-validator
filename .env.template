# AIPG Validator Node - copy to .env and `chmod 600 .env`. Never commit .env.
# V0 preview: run as an observer/scorer with VALIDATOR_REQUIRE_STAKE=false.

# ── Grid ──
GRID_API_URL=https://api.aipowergrid.io
# V2 Grid API key with validator.assignments/probe/attest/read scopes.
VALIDATOR_API_KEY=

# ── Identity / on-chain (Base) ──
# Required. This wallet must be linked to the Grid account that issued the key.
VALIDATOR_WALLET=
# Required. The private key signs registration and attestations. SECRET.
# It must derive VALIDATOR_WALLET. `aipg-validator init` can derive
# the wallet for you when you leave the wallet prompt blank.
VALIDATOR_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
# Must be a valid 20-byte 0x address when set.
AIPG_TOKEN_ADDR=0xa1c0deCaFE3E9Bf06A5F29B7015CD373a9854608
# Set once ValidatorStaking is deployed. Must be a valid 20-byte 0x address
# when set.
VALIDATOR_STAKING_ADDR=
VALIDATOR_MIN_STAKE=50000
# V0 preview / local dev: skip the on-chain stake gate.
VALIDATOR_REQUIRE_STAKE=false

# ── Probing ──
PROBE_INTERVAL_S=60
VALIDATOR_STATE_DB=~/.aipg-validator/state.sqlite3
VALIDATOR_OUTBOX_MAX_ATTEMPTS=20
VALIDATOR_OUTBOX_MAX_AGE_S=1800
PROBE_TIMEOUT_S=180
PROBE_MAX_TOKENS=256
LATENCY_BUDGET_S=30
# Future media/video scorer knobs. They are not used by the assignment-bound
# text preview until media lanes are enabled.
MEDIA_LATENCY_BUDGET_S=60
VIDEO_LATENCY_BUDGET_S=120
PHASH_TOLERANCE=12
VIDEO_PHASH_TOLERANCE=12
VIDEO_MOTION_TOLERANCE=8
# Future assignment-bound media is disabled unless this exact HTTPS-origin
# allowlist is configured. Comma-separate origins; never include URL paths.
VALIDATOR_MEDIA_ALLOWED_ORIGINS=
VALIDATOR_MEDIA_MAX_BYTES=67108864
VALIDATOR_MEDIA_FETCH_TIMEOUT_S=30
VALIDATOR_VIDEO_DECODE_TIMEOUT_S=15

# ── Local dashboard ──
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8790
